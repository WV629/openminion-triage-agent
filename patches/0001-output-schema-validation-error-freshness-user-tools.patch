+    def _instructions_with_output_contract(self) -> str | None:
+        """Append the ``output_type`` JSON Schema so the model knows the contract.
+
+        Without this, ``output_type`` is only checked after the fact and the
+        model never sees the schema it is validated against.
+        """
+        base = (self.instructions or "").strip()
+        output_type = self.output_type
+        if not (
+            isinstance(output_type, type)
+            and issubclass(output_type, BaseModel)
+        ):
+            return base or None
+        schema = json.dumps(output_type.model_json_schema(), separators=(",", ":"))
+        contract = (
+            "Final answer format: reply with ONLY one JSON object (no Markdown, "
+            "no prose, no code fences) that validates against this JSON Schema: "
+            + schema
+        )
+        return f"{base}\n\n{contract}" if base else contract
+
     def _coerce_output(self, text: str) -> OutputT:
         if self.output_type is None or self.output_type is str:
             return cast(OutputT, text)
